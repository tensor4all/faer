diff --git a/faer/src/dc_probe.rs b/faer/src/dc_probe.rs
new file mode 100644
index 00000000..4c578162
--- /dev/null
+++ b/faer/src/dc_probe.rs
@@ -0,0 +1,126 @@
+//! Throwaway instrumentation for tensor4all/faer#391 increment 1 (not for landing).
+//!
+//! Accumulates wall time (ns), call counts and allocation counts per
+//! (recursion level, phase) of the tridiagonal divide-and-conquer, in process-wide
+//! atomics, so that time spent on any team member is counted.
+use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+pub const MAX_LEVEL: usize = 10;
+pub const PHASES: &[&str] = &[
+	"split",
+	"leaf",
+	"z_build",
+	"merge_perm",
+	"deflate",
+	"secular",
+	"lowner",
+	"sort_perm",
+	"vectors",
+	"hh_apply",
+	"gemm",
+	"copy_out",
+	"outer_pre",
+	"dc_wrap",
+	"outer_post",
+];
+pub const N_PHASES: usize = 15;
+pub const SPLIT: usize = 0;
+pub const LEAF: usize = 1;
+pub const Z_BUILD: usize = 2;
+pub const MERGE_PERM: usize = 3;
+pub const DEFLATE: usize = 4;
+pub const SECULAR: usize = 5;
+pub const LOWNER: usize = 6;
+pub const SORT_PERM: usize = 7;
+pub const VECTORS: usize = 8;
+pub const HH_APPLY: usize = 9;
+pub const GEMM: usize = 10;
+pub const COPY_OUT: usize = 11;
+pub const OUTER_PRE: usize = 12;
+pub const DC_WRAP: usize = 13;
+pub const OUTER_POST: usize = 14;
+
+const Z: AtomicU64 = AtomicU64::new(0);
+const ZL: [AtomicU64; N_PHASES] = [Z; N_PHASES];
+pub static NS: [[AtomicU64; N_PHASES]; MAX_LEVEL] = [ZL; MAX_LEVEL];
+pub static CALLS: [[AtomicU64; N_PHASES]; MAX_LEVEL] = [ZL; MAX_LEVEL];
+pub static ALLOC: [[AtomicU64; N_PHASES]; MAX_LEVEL] = [ZL; MAX_LEVEL];
+/// merges per level whose two half-solves were joined in parallel / sequentially
+pub static HALVES_PAR: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+pub static HALVES_SEQ: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+/// merges per level whose two GEMMs were joined in parallel / sequentially
+pub static GEMM_PAR: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+pub static GEMM_SEQ: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+/// non-deflated size k summed per level (divide by merge count for the mean)
+pub static K_SUM: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+/// leaf sizes seen (index = size, capped)
+pub static LEAF_SIZE: [AtomicU64; 257] = [Z; 257];
+/// incremented by the probe binary's global allocator
+pub static ALLOCS: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Copy, Clone)]
+pub struct Mark {
+	t: Instant,
+	a: u64,
+}
+#[inline(always)]
+pub fn mark() -> Mark {
+	Mark {
+		a: ALLOCS.load(Relaxed),
+		t: Instant::now(),
+	}
+}
+/// adds the time since `m` to (level, phase) and returns a fresh mark
+#[inline(always)]
+pub fn lap(level: usize, phase: usize, m: Mark) -> Mark {
+	let now = Instant::now();
+	let a = ALLOCS.load(Relaxed);
+	let l = level.min(MAX_LEVEL - 1);
+	NS[l][phase].fetch_add((now - m.t).as_nanos() as u64, Relaxed);
+	CALLS[l][phase].fetch_add(1, Relaxed);
+	ALLOC[l][phase].fetch_add(a - m.a, Relaxed);
+	Mark { t: Instant::now(), a: ALLOCS.load(Relaxed) }
+}
+pub fn reset() {
+	for l in 0..MAX_LEVEL {
+		for p in 0..N_PHASES {
+			NS[l][p].store(0, Relaxed);
+			CALLS[l][p].store(0, Relaxed);
+			ALLOC[l][p].store(0, Relaxed);
+		}
+		HALVES_PAR[l].store(0, Relaxed);
+		HALVES_SEQ[l].store(0, Relaxed);
+		GEMM_PAR[l].store(0, Relaxed);
+		GEMM_SEQ[l].store(0, Relaxed);
+		K_SUM[l].store(0, Relaxed);
+	}
+	for s in LEAF_SIZE.iter() {
+		s.store(0, Relaxed);
+	}
+}
+
+// ---- count-only build (`dc-count`): secular-equation work per level, never timed ----
+pub static SEC_ROOTS: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+pub static SEC_EVALS: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+pub static SEC_BATCH: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+pub static SEC_TERMS: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+pub static SEC_BISECT_ROOTS: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+pub static SEC_BISECT_EVALS: [AtomicU64; MAX_LEVEL] = [Z; MAX_LEVEL];
+std::thread_local! {
+	pub static CUR_LEVEL: core::cell::Cell<usize> = const { core::cell::Cell::new(0) };
+}
+#[inline(always)]
+pub fn cnt(arr: &[AtomicU64; MAX_LEVEL], v: u64) {
+	if cfg!(feature = "dc-count") {
+		let l = CUR_LEVEL.with(|c| c.get()).min(MAX_LEVEL - 1);
+		arr[l].fetch_add(v, Relaxed);
+	}
+}
+pub fn reset_counts() {
+	for l in 0..MAX_LEVEL {
+		for a in [&SEC_ROOTS, &SEC_EVALS, &SEC_BATCH, &SEC_TERMS, &SEC_BISECT_ROOTS, &SEC_BISECT_EVALS] {
+			a[l].store(0, Relaxed);
+		}
+	}
+}
